PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
TZ=Asia/Kolkata

# Database: leave DATABASE_URL empty to use SQLite (zero setup). For production use PostgreSQL:
# DATABASE_URL=postgres://user:pass@host:5432/nerkanal
# DB_SSL=true
DB_SYNC=true            # set false in production and use migrations

# Email (OTP, meeting links, notifications). Empty = emails are only logged.
# SMTP_URL=smtps://user:pass@smtp.gmail.com
MAIL_FROM=Nerkanal <no-reply@nerkanal.app>

# SMS (optional, Twilio)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# Jarvis AI (Anthropic API). Empty = limited rule-based Jarvis.
# ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-sonnet-5-5

# External job feeds. Remotive works with no key. JSearch (RapidAPI) covers LinkedIn/Indeed/Glassdoor listings.
# RAPIDAPI_KEY=
JOB_SYNC_QUERIES=developer,marketing,sales,hr

# Video-intro AI provider (must return {faceDetected, communication, confidence, passion} 0-100). Empty = DEMO scorer.
# VIDEO_AI_URL=
# VIDEO_AI_KEY=
